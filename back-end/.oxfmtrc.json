{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["dist", "node_modules"],
  "semi": false,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "none",
  "printWidth": 80,
  "sortImports": {
    "newlinesBetween": true,
    "order": "asc"
  },
  "sortPackageJson": true
}
