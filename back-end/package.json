{
  "name": "back-end",
  "version": "1.0.0",
  "description": "Techzu Back-end",
  "license": "LICENSE.md",
  "author": "Xia",
  "type": "module",
  "main": "./dist/serve.js",
  "scripts": {
    "dev": "node --import=tsx --env-file=.env --watch src/serve.ts",
    "build": "node esbuild.js",
    "start": "node dist/server.js",
    "db:migrate": "node --env-file=.env node_modules/.bin/prisma migrate dev",
    "db:generate": "node --env-file=.env node_modules/.bin/prisma generate",
    "db:seed": "node --env-file=.env ./prisma/seed.js",
    "db:fmt": "node --env-file=.env node_modules/.bin/prisma format"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/socket.io": "^3.0.1",
    "esbuild": "^0.28.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "prisma": "^7.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
